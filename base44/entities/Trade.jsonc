{
  "name": "Trade",
  "type": "object",
  "properties": {
    "pair": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "lot_size": {
      "type": "number"
    },
    "open_price": {
      "type": "number"
    },
    "close_price": {
      "type": "number"
    },
    "pnl": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED"
      ],
      "default": "OPEN"
    },
    "is_auto": {
      "type": "boolean",
      "default": true
    },
    "bot_id": {
      "type": "string",
      "description": "ID of the bot that executed this trade"
    },
    "ticket": {
      "type": "number",
      "description": "MT4/MT5 Order Ticket Number"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who owns this trade (for MT4/MT5 sync)"
    },
    "close_requested": {
      "type": "boolean",
      "default": false,
      "description": "Set by monitorBotPerformance (bot close-all-at-profit/loss). The bridge returns these OPEN trades as close_commands so the EA flattens the broker position; bridge reconcile then marks the trade CLOSED with the real fill pnl."
    }
  },
  "required": [
    "pair",
    "type",
    "lot_size",
    "open_price"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}