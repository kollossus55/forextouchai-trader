{
  "name": "CurrencyPair",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "current_price": {
      "type": "number"
    },
    "change_24h": {
      "type": "number"
    },
    "volatility": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "spread": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "MAJOR",
        "MINOR"
      ],
      "default": "MAJOR"
    },
    "ai_signal": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL",
        "NEUTRAL"
      ],
      "default": "NEUTRAL"
    },
    "ai_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    }
  },
  "required": [
    "symbol"
  ]
}