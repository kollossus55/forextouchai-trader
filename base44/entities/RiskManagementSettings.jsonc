{
  "name": "RiskManagementSettings",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "Broker account number this risk setting applies to. Empty = global default."
    },
    "max_daily_loss_percent": {
      "type": "number",
      "default": 5,
      "minimum": 0,
      "maximum": 100,
      "description": "Maximum allowed loss per day as % of account balance"
    },
    "max_drawdown_percent": {
      "type": "number",
      "default": 20,
      "minimum": 0,
      "maximum": 100,
      "description": "Maximum allowed drawdown from peak equity as %"
    },
    "max_position_size_percent": {
      "type": "number",
      "default": 10,
      "minimum": 0,
      "maximum": 100,
      "description": "Maximum position size as % of account balance"
    },
    "max_concurrent_trades": {
      "type": "number",
      "default": 10,
      "minimum": 1,
      "maximum": 100,
      "description": "Maximum number of open trades for this account"
    },
    "risk_per_trade_percent": {
      "type": "number",
      "default": 2,
      "minimum": 0.1,
      "maximum": 10,
      "description": "Maximum risk per individual trade as % of balance"
    },
    "alert_threshold_percent": {
      "type": "number",
      "default": 80,
      "minimum": 50,
      "maximum": 100,
      "description": "Alert when risk reaches this % of limit"
    },
    "stop_trading_on_limit": {
      "type": "boolean",
      "default": true,
      "description": "Automatically stop this account's bots when limits are breached"
    },
    "daily_profit_target_percent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100,
      "description": "Close all trades and pause when daily profit reaches this % of balance (0 = disabled)"
    },
    "daily_reset_hour": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 23,
      "description": "UTC hour at which the daily counters reset and trading resumes (0 = midnight UTC)"
    },
    "auto_resume_hours": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 24,
      "description": "Auto-resume trading this many hours after a limit breach or profit target pause (0 = disabled, only resets at daily_reset_hour)"
    },
    "stale_forex_hours": {
      "type": "number",
      "default": 24,
      "minimum": 1,
      "maximum": 168,
      "description": "Hours a forex pair trade must be open before it's flagged stale"
    },
    "stale_index_hours": {
      "type": "number",
      "default": 48,
      "minimum": 1,
      "maximum": 168,
      "description": "Hours an index pair trade must be open before it's flagged stale"
    },
    "stale_loss_threshold": {
      "type": "number",
      "default": -10,
      "description": "PnL floor (negative, e.g. -10). A trade open past the stale-hours threshold with PnL at or below this is flagged stale."
    },
    "daily_loss_current": {
      "type": "number",
      "default": 0,
      "description": "Current daily loss tracking"
    },
    "peak_equity": {
      "type": "number",
      "default": 0,
      "description": "Peak account equity for drawdown calculation"
    },
    "last_reset_date": {
      "type": "string",
      "format": "date",
      "description": "Last date daily loss was reset"
    },
    "auto_trade_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Manual auto-trade toggle for this account (independent of risk-pause). When false, the bridge/generator skip auto/bot signals for this account but manual signals still pass."
    },
    "is_trading_paused": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating if trading is paused for this account due to risk limits (set by monitorRiskLimits; cleared at daily reset)"
    },
    "limit_hit_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the last limit breach or profit target pause occurred; used for auto-resume"
    },
    "global_schedule_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the global weekly trading schedule. When true, the app blocks ALL new trades (auto + manual) outside each day's ON window and flattens all open positions when the OFF window starts."
    },
    "weekly_schedule": {
      "type": "object",
      "description": "Per-day UTC on/off windows. Keys: mon,tue,wed,thu,fri,sat,sun. Each value: { on: 'HH:MM', off: 'HH:MM' }. Outside the window = app off (block + close all). on==off means off all day.",
      "properties": {
        "mon": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "off": {
              "type": "string"
            }
          }
        },
        "tue": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "off": {
              "type": "string"
            }
          }
        },
        "wed": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "off": {
              "type": "string"
            }
          }
        },
        "thu": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "off": {
              "type": "string"
            }
          }
        },
        "fri": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "off": {
              "type": "string"
            }
          }
        },
        "sat": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "off": {
              "type": "string"
            }
          }
        },
        "sun": {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "off": {
              "type": "string"
            }
          }
        }
      }
    },
    "flatten_on_breach": {
      "type": "boolean",
      "default": true,
      "description": "On a daily-loss or drawdown breach, also close open positions rather than only blocking new ones. Previously a breach paused new signals while existing trades kept running past the limit, so the limit did not limit anything. Set false only if you deliberately want to hold through a breach."
    },
    "max_trades_per_currency": {
      "type": "number",
      "default": 3,
      "minimum": 1,
      "maximum": 50,
      "description": "Maximum simultaneous open FOREX trades sharing a currency leg. Ten USD-quoted longs are one large short-USD position, not ten independent trades \u2014 this is the cap that prevents that. Applies only to forex pairs; indices have their own separate limit."
    },
    "max_trades_per_index_currency": {
      "type": "number",
      "default": 3,
      "minimum": 1,
      "maximum": 20,
      "description": "Maximum simultaneous open INDEX trades sharing a quote currency (e.g. UK100 and AUS200 both quote GBP). Independent from the forex currency limit so the two asset classes don't block each other."
    },
    "max_risk_percent_per_currency": {
      "type": "number",
      "default": 4,
      "minimum": 0.5,
      "maximum": 50,
      "description": "Maximum NET risk as a percent of balance on any single currency, aggregated across correlated pairs."
    },
    "max_total_risk_percent": {
      "type": "number",
      "default": 6,
      "minimum": 0.5,
      "maximum": 100,
      "description": "Maximum combined risk across all open positions, as a percent of balance."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}