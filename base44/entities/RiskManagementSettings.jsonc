{
  "name": "RiskManagementSettings",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "Broker account number this risk setting applies to. Empty = global default."
    },
    "max_daily_loss_percent": {
      "type": "number",
      "default": 5,
      "minimum": 0,
      "maximum": 100,
      "description": "Maximum allowed loss per day as % of account balance"
    },
    "max_drawdown_percent": {
      "type": "number",
      "default": 20,
      "minimum": 0,
      "maximum": 100,
      "description": "Maximum allowed drawdown from peak equity as %"
    },
    "max_position_size_percent": {
      "type": "number",
      "default": 10,
      "minimum": 0,
      "maximum": 100,
      "description": "Maximum position size as % of account balance"
    },
    "max_concurrent_trades": {
      "type": "number",
      "default": 10,
      "minimum": 1,
      "maximum": 100,
      "description": "Maximum number of open trades for this account"
    },
    "risk_per_trade_percent": {
      "type": "number",
      "default": 2,
      "minimum": 0.1,
      "maximum": 10,
      "description": "Maximum risk per individual trade as % of balance"
    },
    "alert_threshold_percent": {
      "type": "number",
      "default": 80,
      "minimum": 50,
      "maximum": 100,
      "description": "Alert when risk reaches this % of limit"
    },
    "stop_trading_on_limit": {
      "type": "boolean",
      "default": true,
      "description": "Automatically stop this account's bots when limits are breached"
    },
    "daily_profit_target_percent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100,
      "description": "Close all trades and pause when daily profit reaches this % of balance (0 = disabled)"
    },
    "daily_reset_hour": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 23,
      "description": "UTC hour at which the daily counters reset and trading resumes (0 = midnight UTC)"
    },
    "auto_resume_hours": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 24,
      "description": "Auto-resume trading this many hours after a limit breach or profit target pause (0 = disabled, only resets at daily_reset_hour)"
    },
    "stale_forex_hours": {
      "type": "number",
      "default": 24,
      "minimum": 1,
      "maximum": 168,
      "description": "Hours a forex pair trade must be open before it's flagged stale"
    },
    "stale_index_hours": {
      "type": "number",
      "default": 48,
      "minimum": 1,
      "maximum": 168,
      "description": "Hours an index pair trade must be open before it's flagged stale"
    },
    "stale_loss_threshold": {
      "type": "number",
      "default": -10,
      "description": "PnL floor (negative, e.g. -10). A trade open past the stale-hours threshold with PnL at or below this is flagged stale."
    },
    "daily_loss_current": {
      "type": "number",
      "default": 0,
      "description": "Current daily loss tracking"
    },
    "peak_equity": {
      "type": "number",
      "default": 0,
      "description": "Peak account equity for drawdown calculation"
    },
    "last_reset_date": {
      "type": "string",
      "format": "date",
      "description": "Last date daily loss was reset"
    },
    "auto_trade_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Manual auto-trade toggle for this account (independent of risk-pause). When false, the bridge/generator skip auto/bot signals for this account but manual signals still pass."
    },
    "is_trading_paused": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating if trading is paused for this account due to risk limits (set by monitorRiskLimits; cleared at daily reset)"
    },
    "limit_hit_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the last limit breach or profit target pause occurred; used for auto-resume"
    }
  },
  "required": [],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}