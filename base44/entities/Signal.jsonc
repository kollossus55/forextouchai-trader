{
  "name": "Signal",
  "type": "object",
  "properties": {
    "pair": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "entry_price": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "lot_size": {
      "type": "number",
      "description": "Optional custom lot size for execution"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "strategy": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ANALYSIS",
        "ACTIVE",
        "PENDING",
        "CLOSED",
        "EXPIRED",
        "SKIPPED"
      ],
      "default": "ANALYSIS"
    },
    "result_pnl": {
      "type": "number"
    },
    "bot_id": {
      "type": "string",
      "description": "ID of the bot that generated this signal"
    },
    "owner_email": {
      "type": "string",
      "description": "Target account number for MT4/MT5 routing (set to account_number to route to a specific account)"
    },
    "calculated_indicators": {
      "type": "object",
      "description": "Technical indicator values at time of signal generation"
    },
    "risk_amount": {
      "type": "number",
      "description": "Account-currency amount risked if the stop is hit. Derived from risk_per_trade_percent and the real stop distance."
    },
    "stop_pips": {
      "type": "number",
      "description": "Stop distance in pips, using the correct pip size for this instrument."
    },
    "data_source": {
      "type": "string",
      "enum": ["BROKER", "YAHOO", "UNKNOWN"],
      "description": "Which candle feed produced this signal. BROKER means your own terminal's data."
    }
  },
  "required": [
    "pair",
    "type",
    "entry_price"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}