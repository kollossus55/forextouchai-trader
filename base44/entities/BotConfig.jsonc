{
  "name": "BotConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "strategy_type": {
      "type": "string",
      "enum": [
        "SCALPING",
        "SWING",
        "DAY_TRADING",
        "AI_PREDICTIVE",
        "PRICE_ACTION",
        "SUPPLY_DEMAND",
        "PATTERN_TRADING",
        "CANDLESTICK",
        "HYBRID_ALL",
        "GOLD_XAUUSD",
        "SILVER_XAGUSD",
        "SP500_AI"
      ]
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "M1",
        "M5",
        "M15",
        "M30",
        "H1",
        "H4",
        "D1",
        "W1"
      ],
      "default": "H1",
      "description": "Trading timeframe for analysis and signals"
    },
    "status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "STOPPED",
        "PAUSED"
      ],
      "default": "STOPPED"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "default": "MEDIUM"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lot_size": {
      "type": "number",
      "default": 0.1
    },
    "min_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 75
    },
    "trading_start_time": {
      "type": "string",
      "default": "00:00",
      "description": "Daily trading start time (HH:MM)"
    },
    "trading_end_time": {
      "type": "string",
      "default": "23:59",
      "description": "Daily trading end time (HH:MM)"
    },
    "stop_loss_pips": {
      "type": "number",
      "default": 30
    },
    "take_profit_pips": {
      "type": "number",
      "default": 60
    },
    "max_open_trades": {
      "type": "number",
      "default": 5,
      "description": "Maximum number of concurrent open trades"
    },
    "max_trades_per_pair": {
      "type": "number",
      "default": 1,
      "minimum": 1,
      "maximum": 10,
      "description": "Maximum concurrent open trades on the same currency pair"
    },
    "max_daily_trades": {
      "type": "number",
      "default": 0,
      "description": "Maximum trades per day (0 = unlimited)"
    },
    "sl_tp_mode": {
      "type": "string",
      "enum": [
        "FIXED",
        "ATR"
      ],
      "default": "FIXED"
    },
    "atr_period": {
      "type": "number",
      "default": 14
    },
    "atr_multiplier_sl": {
      "type": "number",
      "default": 1.5
    },
    "atr_multiplier_tp": {
      "type": "number",
      "default": 3
    },
    "money_management": {
      "type": "string",
      "enum": [
        "FIXED",
        "MARTINGALE"
      ],
      "default": "FIXED"
    },
    "martingale_multiplier": {
      "type": "number",
      "default": 2
    },
    "enable_trailing_stop": {
      "type": "boolean",
      "default": false,
      "description": "Enable trailing stop loss"
    },
    "trailing_stop_pips": {
      "type": "number",
      "default": 20,
      "description": "Distance in pips for trailing stop"
    },
    "trailing_start_pips": {
      "type": "number",
      "default": 30,
      "description": "Start trailing after this many pips in profit"
    },
    "hide_sl_tp": {
      "type": "boolean",
      "default": false,
      "description": "Hide SL/TP from broker (managed internally)"
    },
    "close_all_at_profit_percent": {
      "type": "number",
      "default": 0,
      "description": "Close all trades when total profit reaches % (0 = disabled)"
    },
    "close_all_at_loss_percent": {
      "type": "number",
      "default": 0,
      "description": "Close all trades when total loss reaches % (0 = disabled)"
    },
    "max_spread_pips": {
      "type": "number",
      "default": 3,
      "description": "Don't open trades if spread exceeds this"
    },
    "enable_news_filter": {
      "type": "boolean",
      "default": false,
      "description": "Pause trading during high-impact news"
    },
    "auto_execution": {
      "type": "boolean",
      "default": false,
      "description": "Allow AI to open/close trades on MT4/MT5 directly"
    },
    "use_ai_risk": {
      "type": "boolean",
      "default": false,
      "description": "Auto-adjust Stop Loss & Lot Size based on volatility"
    },
    "sp500_use_ha": {
      "type": "boolean",
      "default": true,
      "description": "SP500_AI: require Heikin-Ashi candle direction gate"
    },
    "sp500_use_ssl": {
      "type": "boolean",
      "default": true,
      "description": "SP500_AI: require SSL Channel trend gate"
    },
    "sp500_use_ai_rsi": {
      "type": "boolean",
      "default": true,
      "description": "SP500_AI: require AI RSI momentum gate"
    },
    "sp500_use_tmo": {
      "type": "boolean",
      "default": true,
      "description": "SP500_AI: require TMO trend-momentum oscillator gate"
    },
    "sp500_use_sd": {
      "type": "boolean",
      "default": false,
      "description": "SP500_AI: require Supply & Demand zone confirmation. When ON, the bot only trades in the direction of a confirmed institutional zone (order block / FVG) on the higher timeframe \u2014 signals without a confirmed zone, or fighting the zone direction, are blocked."
    },
    "ind_use_rsi": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight RSI"
    },
    "ind_use_macd": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight MACD"
    },
    "ind_use_ema": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight EMA stack"
    },
    "ind_use_stochastic": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight Stochastic"
    },
    "ind_use_bollinger": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight Bollinger Bands"
    },
    "ind_use_atr": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight ATR / volatility"
    },
    "ind_use_adx": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight ADX regime"
    },
    "ind_use_cci": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight CCI"
    },
    "ind_use_vwap": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight VWAP"
    },
    "ind_use_chart_patterns": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight chart patterns"
    },
    "ind_use_candlestick": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight candlestick confirmation"
    },
    "ind_use_fibonacci": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight Fibonacci confluence"
    },
    "ind_use_structure": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight market structure (BOS/CHoCH/OB/FVG/S&D)"
    },
    "ind_use_liquidity": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight liquidity sweeps / stop hunts"
    },
    "ind_use_session_timing": {
      "type": "boolean",
      "default": true,
      "description": "AI strategies: require/weight session timing"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who owns this bot"
    },
    "use_llm_confirmation": {
      "type": "boolean",
      "default": false,
      "description": "Send the COMPUTED indicator readings to a language model for a second opinion. The model cannot change direction and can only LOWER confidence or veto \u2014 it never sees or invents price data. Off by default: the deterministic path is the one the backtester measures, and adding a non-deterministic layer makes results harder to reproduce."
    },
    "require_htf_alignment": {
      "type": "boolean",
      "default": true,
      "description": "Reject signals that fight the higher-timeframe bias. This is the single most effective filter in the system; turn it off only for genuine counter-trend strategies."
    },
    "min_adx": {
      "type": "number",
      "default": 20,
      "minimum": 0,
      "maximum": 60,
      "description": "ADX below this contributes no trend weight to the confluence score."
    },
    "avoid_rollover": {
      "type": "boolean",
      "default": true,
      "description": "Block entries in the 20:45-21:15 UTC rollover window, where spreads widen sharply and stops are hit by cost rather than price."
    },
    "min_session_quality": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1,
      "description": "Minimum session liquidity (1.0 London/NY overlap, 0.95 London, 0.9 NY, 0.75 Tokyo, 0.6 Sydney). 0 allows any session. Does not apply to crypto."
    }
  },
  "required": [
    "name",
    "strategy_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}